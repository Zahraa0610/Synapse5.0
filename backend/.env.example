# Copy this file to backend/.env and fill in your values. Never commit .env.

# Secret used to sign login tokens (any long random text)
MAAK_SECRET=change-me-to-a-long-random-string

# Firebase: path to the service account key you downloaded (see README)
FIREBASE_CREDENTIALS=firebase-key.json

# Twilio WhatsApp (see README). Leave empty to print codes in the console instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional, for an approved WhatsApp template (outside the sandbox)
TWILIO_CONTENT_SID=
